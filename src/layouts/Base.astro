---
import type { Locale } from '../config';
import { siteConfig } from '../config';
import { getUi } from '../i18n/ui';
import { organizationSchema, websiteSchema } from '../lib/seo';
import { adsenseClient } from '../lib/ads';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import LangBanner from '../components/LangBanner.astro';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  alternatePath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Array<Record<string, unknown>>;
  noindex?: boolean;
  bodyClass?: string;
  /** Set to false for pages where advertising is not appropriate. */
  showAds?: boolean;
}

const {
  locale,
  title,
  description,
  canonicalPath,
  alternatePath,
  ogImage = '/og/default.png',
  ogType = 'website',
  jsonLd = [],
  noindex = false,
  bodyClass = '',
  showAds = true,
} = Astro.props;

const origin = Astro.site?.origin ?? 'https://www.toolabs.web.id';
const canonical = new URL(canonicalPath, origin).toString();
const ogAbsolute = new URL(ogImage, origin).toString();
const ui = getUi(locale);
const gtmId = import.meta.env.PUBLIC_GTM_ID;
// AdSense is never loaded on noindex pages (404, previews), in line with
// Google's policy against serving ads on screens with no content.
const loadAds = showAds && !noindex && Boolean(adsenseClient);
const schemas = [organizationSchema(origin), websiteSchema(origin, locale), ...jsonLd];
const alternateAbsolute = alternatePath ? new URL(alternatePath, origin).toString() : null;
const ogLocale = locale === 'id' ? 'id_ID' : 'en_US';
const ogLocaleAlternate = locale === 'id' ? 'en_US' : 'id_ID';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternatePath && (
      <>
        <link rel="alternate" hreflang="en" href={locale === 'en' ? canonical : alternateAbsolute} />
        <link rel="alternate" hreflang="id" href={locale === 'id' ? canonical : alternateAbsolute} />
        <link rel="alternate" hreflang="x-default" href={locale === 'en' ? canonical : alternateAbsolute} />
      </>
    )}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="theme-color" content="#0e211c" />
    <meta name="color-scheme" content="light" />
    {adsenseClient && <meta name="google-adsense-account" content={adsenseClient} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-180.png" sizes="180x180" type="image/png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbsolute} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />

    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    ))}

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.toolabsTrack = function (event, params) {
        window.dataLayer.push(Object.assign({ event: event }, params || {}));
      };
    </script>

    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', gtmId);
      </script>
    )}
    {loadAds && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body class={bodyClass}>
    {gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
          title="Google Tag Manager"
        ></iframe>
      </noscript>
    )}
    <a class="skip-link" href="#main">{ui.skip}</a>
    <Navbar locale={locale} alternatePath={alternatePath} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <LangBanner locale={locale} alternatePath={alternatePath} />

    <script>
      document.addEventListener('click', (event) => {
        const link = (event.target as Element).closest<HTMLElement>('[data-track-related]');
        if (link) {
          window.toolabsTrack?.('related_tool_clicked', {
            tool: link.dataset.trackRelated,
          });
        }
      });
    </script>
  </body>
</html>
