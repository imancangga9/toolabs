---
interface Crumb {
  name: string;
  href?: string;
}

interface Props {
  items: Crumb[];
  label?: string;
}

const { items, label = 'Breadcrumb' } = Astro.props;
---

<nav class="breadcrumbs" aria-label={label}>
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href ? <a href={item.href}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
        {index < items.length - 1 && <span aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
